  "cards": [
    {
      "dot": "emerald", "title": "Request rules",
      "items": [
        "/upload writes nothing until every page is rendered and embedded",
        "Blocked or attack-labelled questions get a fixed refusal; clarify and off_topic are only shown",
        "Model errors return 502 and an unknown doc_id 404; neither is logged",
        "Code, not the model, sets each citation's status and boxes"
      ]
    },
    {
      "dot": "cyan", "title": "Runtime limits",
      "items": [
        "Cloud Run: min 1, max 2 instances, one request each (PyMuPDF is not thread-safe)",
        "Gemini calls time out at 60 s, inside Cloud Run's 300 s request limit",
        "Retrieval is an exact cosine search over one document's pages, no vector index"
      ]
    },
    {
      "dot": "rose", "title": "Data residency",
      "items": [
        "Cloud Run, Cloud Storage and BigQuery run in europe-north1",
        "Gemini is called through the eu multi-region endpoint",
        "Only the question text goes to Jev; TypeSafe names no EU region"
      ]
    },
    {
      "dot": "amber", "title": "Provisioning and scripts",
      "items": [
        "setup.sh enables APIs, creates the seetonic-run account and its roles, the bucket, dataset and both tables",
        "smoke.py and evaluate.py call the live API and write real data",
        "search.py imports gemini.py and store.py and queries Gemini and BigQuery directly"
      ]
    }
  ]
